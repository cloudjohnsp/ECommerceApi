{
  "info": {
    "_postman_id": "f3850697-3c37-4c40-a314-4552cc8e75ce",
    "name": "ECommerce API",
    "description": "Fluxos principais da API versionada. Execute Login depois de informar email e password no ambiente; o token Bearer é salvo automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 2 seconds', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{hostUrl}}/api/health/live"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is live', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{confirmationToken}}\"\n}"
            },
            "description": "Copie o token do e-mail entregue pelo Mailpit antes de executar.",
            "url": "{{baseUrl}}/auth/confirm-email"
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Authenticated', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token rotated', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "  pm.environment.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog administration",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Peripherals {{$randomInt}}\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Category created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('categoryId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard {{$randomInt}}\",\n  \"description\": \"Hot-swappable mechanical keyboard\",\n  \"price\": 399.90,\n  \"stock\": 25,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            },
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Product created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create additional product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gaming Mouse {{$randomInt}}\",\n  \"description\": \"Wireless gaming mouse\",\n  \"price\": 249.90,\n  \"stock\": 25,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            },
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Additional product created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('additionalProductId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Sales report (last 30 days)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('reportToUtc', new Date().toISOString());",
                  "pm.variables.set('reportFromUtc', new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/reports/sales?fromUtc={{reportFromUtc}}&toUtc={{reportToUtc}}&topProducts=10"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Search products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/products?search=keyboard&sortBy=price&page=1&pageSize=20"
          }
        },
        {
          "name": "List categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        }
      ]
    },
    {
      "name": "Orders and payments",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add item to pending order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{additionalProductId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Item added to order', () => pm.response.to.have.status(200));",
                  "pm.test('Order contains two items', () => pm.expect(pm.response.json().items).to.have.length(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"currency\": \"BRL\"\n}"
            },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/payments/{{orderId}}"
          }
        },
        {
          "name": "Refund payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"customer_request\"\n}"
            },
            "url": "{{baseUrl}}/payments/{{orderId}}/refund"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/user/{{userId}}"
          }
        },
        {
          "name": "Get audit history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/user/{{userId}}/history?page=1&pageSize=20"
          }
        }
      ]
    }
  ]
}
