{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "MaxAttempts": 10,
    "RetryDelaySeconds": 3
  },
  "DatabaseSeed": {
    "Enabled": false,
    "SeedSampleCatalog": true,
    "AdministratorEmail": "",
    "AdministratorPassword": ""
  },
  "Jwt": {
    "Issuer": "ECommerceApi",
    "Audience": "ECommerceApi",
    "SecretKey": "",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "ClientProvidedName": "ecommerce-api",
    "ExchangeName": "ecommerce.events"
  },
  "Redis": {
    "Enabled": true,
    "Configuration": "localhost:6379,abortConnect=false,connectTimeout=1000",
    "InstanceName": "ecommerce:",
    "ProductExpirationMinutes": 5,
    "CategoryExpirationMinutes": 10
  },
  "ProductImageStorage": {
    "Enabled": true,
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "product-images",
    "PublicBaseUrl": "http://127.0.0.1:10000/devstoreaccount1/product-images"
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "no-reply@ecommerce.local",
    "FromName": "ECommerce",
    "PublicAppBaseUrl": "http://localhost:3000"
  },
  "PaymentGateway": {
    "BaseUrl": "http://localhost:5002",
    "CallbackUrl": "http://localhost:5000/api/webhooks/payments",
    "WebhookSecret": "",
    "TimeoutSeconds": 10
  },
  "OutboxProcessor": {
    "Enabled": true,
    "CronExpression": "* * * * *",
    "BatchSize": 20,
    "WorkerCount": 3
  },
  "ApiProtection": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "GlobalPermitLimit": 100,
    "AuthenticationPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Observability": {
    "ServiceName": "ECommerce.Api",
    "EnablePrometheus": true,
    "OtlpEndpoint": null
  },
  "FeatureFlags": {
    "AdminDashboard": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
