    "FromName": "ECommerce"
  },
  "NotificationProcessor": {
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "LockSeconds": 60,
    "MaximumAttempts": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
