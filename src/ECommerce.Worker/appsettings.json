{
  "ConnectionStrings": {
    "WorkerDatabase": ""
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "ClientProvidedName": "ecommerce-worker",
    "ExchangeName": "ecommerce.events",
