# Run scripts/start-local.ps1 to create .env with local secrets and start Docker Compose.
# Alternatively, copy this file to .env and replace every value manually.
# The .env file is ignored by Git.
# Paths are resolved from this repository, where docker-compose.yml lives.
ECOMMERCE_WORKER_CONTEXT=../../../personal-projects/ECommerceWorker
ECOMMERCE_PAYMENT_CONTEXT=../../../personal-projects/ECommercePayment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=
JWT_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
DATABASE_SEED_ENABLED=true
SEED_SAMPLE_CATALOG=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
