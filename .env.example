# Run scripts/start-local.ps1 to create .env with local secrets and start Docker Compose.
# Alternatively, copy this file to .env and replace every value manually.
# The .env file is ignored by Git.
# Paths are resolved from this repository, where docker-compose.yml lives.
ECOMMERCE_WORKER_CONTEXT=../../../personal-projects/ECommerceWorker
ECOMMERCE_PAYMENT_CONTEXT=../../../personal-projects/ECommercePayment
# Optional prebuilt images. The default local flow builds these names.
ECOMMERCE_API_IMAGE=ecommerce-api:local
ECOMMERCE_WORKER_IMAGE=ecommerce-worker:local
ECOMMERCE_PAYMENT_IMAGE=ecommerce-payment:local
# Optional host-port overrides used by isolated coordinated gates.
ECOMMERCE_API_PORT=8080
PAYMENT_GATEWAY_PORT=5002
MAILPIT_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
RABBITMQ_MANAGEMENT_PORT=15672
AZURITE_PORT=10000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=
JWT_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
DATABASE_SEED_ENABLED=true
SEED_SAMPLE_CATALOG=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
